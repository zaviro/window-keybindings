#!/usr/bin/env bash
set -euo pipefail

PROGRAM=${0##*/}
RUNTIME_ROOT=${XDG_RUNTIME_DIR:-/tmp/window-keybindings-${UID}}
RUNTIME_DIR="$RUNTIME_ROOT/window-keybindings"
LOCK_FILE="$RUNTIME_DIR/lock"
SPAWN_WAIT_ATTEMPTS=${WKB_SPAWN_WAIT_ATTEMPTS:-100}
SPAWN_WAIT_INTERVAL=${WKB_SPAWN_WAIT_INTERVAL:-0.1}

usage() {
  cat <<'USAGE'
Usage:
  window-keybindings contextual ROLE APP_ID_REGEX -- COMMAND [ARG...]
  window-keybindings singleton ROLE APP_ID_REGEX -- COMMAND [ARG...]
  window-keybindings inspect

Compatibility aliases:
  local  -> contextual
  single -> singleton

Role policy:
  contextual
    Resolve matching windows only on the current workspace. Focus the MRU
    match, or create a new matching window when none exists.

  singleton
    Resolve matching windows globally. Focus/summon the global MRU match,
    or create one when none exists.

v0.7 intentionally has no Global Main role, no global/global-state command,
and no persistent/runtime window identity state. APP_ID_REGEX is matched
case-insensitively against niri's Wayland app_id.
USAGE
}

fail() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

lock_runtime() {
  mkdir -p "$RUNTIME_DIR"
  exec 9>"$LOCK_FILE"
  flock 9
}

windows_json() {
  niri msg --json windows
}

workspaces_json() {
  niri msg --json workspaces
}

focused_workspace() {
  workspaces_json | jq -c 'map(select(.is_focused == true)) | first // empty'
}

window_by_id() {
  local id=$1
  windows_json | jq -c --argjson id "$id" 'map(select(.id == $id)) | first // empty'
}

mru_matching_window() {
  local app_re=$1
  local workspace_id=${2:-}

  windows_json | jq -c \
    --arg re "$app_re" \
    --arg workspace_id "$workspace_id" '
      [ .[]
        | select((.app_id // "") | test($re; "i"))
        | select(($workspace_id == "") or ((.workspace_id | tostring) == $workspace_id))
      ]
      | if length == 0 then empty
        else max_by([(.focus_timestamp.secs // 0), (.focus_timestamp.nanos // 0), .id])
        end
    '
}

focus_window() {
  local id=$1
  niri msg action focus-window --id "$id" >/dev/null
}

workspace_reference() {
  local workspace_json=$1
  local name idx

  name=$(jq -r '.name // empty' <<<"$workspace_json")
  if [[ -n "$name" ]]; then
    printf '%s\n' "$name"
    return
  fi

  idx=$(jq -r '.idx' <<<"$workspace_json")
  printf '%s\n' "$idx"
}

move_and_focus_to_workspace() {
  local id=$1
  local target_workspace=$2
  local target_id window current_window_ws ref

  target_id=$(jq -r '.id' <<<"$target_workspace")
  window=$(window_by_id "$id")
  [[ -n "$window" ]] || fail "window $id disappeared"
  current_window_ws=$(jq -r '.workspace_id // empty' <<<"$window")

  if [[ "$current_window_ws" != "$target_id" ]]; then
    ref=$(workspace_reference "$target_workspace")
    niri msg action move-window-to-workspace \
      --window-id "$id" \
      --focus false \
      "$ref" >/dev/null
  fi

  focus_window "$id"
}

spawn_and_wait_for_window() {
  local app_re=$1
  shift
  [[ ${1:-} == "--" ]] && shift
  (($# > 0)) || fail "spawn command is empty"

  local before attempt window
  before=$(windows_json | jq '[.[].id]')

  "$@" >/dev/null 2>&1 &

  # Correlate creation by compositor window identity, never by command PID.
  # Chrome-like applications may hand the request to an existing process.
  for ((attempt = 0; attempt < SPAWN_WAIT_ATTEMPTS; attempt++)); do
    window=$(windows_json | jq -c \
      --arg re "$app_re" \
      --argjson before "$before" '
        [ .[]
          | select((.app_id // "") | test($re; "i"))
          | select((.id as $id | $before | index($id)) == null)
        ]
        | if length == 0 then empty
          else max_by([(.focus_timestamp.secs // 0), (.focus_timestamp.nanos // 0), .id])
          end
      ')
    if [[ -n "$window" ]]; then
      jq -r '.id' <<<"$window"
      return 0
    fi
    sleep "$SPAWN_WAIT_INTERVAL"
  done

  return 1
}

run_contextual() {
  local role=$1
  local app_re=$2
  shift 2
  [[ ${1:-} == "--" ]] && shift
  (($# > 0)) || fail "contextual requires a spawn command"

  local ws ws_id window id
  ws=$(focused_workspace)
  [[ -n "$ws" ]] || fail "niri has no focused workspace"
  ws_id=$(jq -r '.id' <<<"$ws")

  window=$(mru_matching_window "$app_re" "$ws_id")
  if [[ -n "$window" ]]; then
    focus_window "$(jq -r '.id' <<<"$window")"
    return
  fi

  if id=$(spawn_and_wait_for_window "$app_re" -- "$@"); then
    move_and_focus_to_workspace "$id" "$ws"
  else
    fail "spawned $role but did not observe a new matching contextual window"
  fi
}

run_singleton() {
  local role=$1
  local app_re=$2
  shift 2
  [[ ${1:-} == "--" ]] && shift
  (($# > 0)) || fail "singleton requires a spawn command"

  local ws window id
  ws=$(focused_workspace)
  [[ -n "$ws" ]] || fail "niri has no focused workspace"

  window=$(mru_matching_window "$app_re")
  if [[ -n "$window" ]]; then
    move_and_focus_to_workspace "$(jq -r '.id' <<<"$window")" "$ws"
    return
  fi

  if id=$(spawn_and_wait_for_window "$app_re" -- "$@"); then
    move_and_focus_to_workspace "$id" "$ws"
  else
    fail "spawned $role singleton but did not observe a matching window"
  fi
}

inspect_state() {
  local workspaces windows
  workspaces=$(workspaces_json)
  windows=$(windows_json)

  jq -n \
    --argjson workspaces "$workspaces" \
    --argjson windows "$windows" \
    '{workspaces: $workspaces, windows: $windows}'
}

main() {
  local command=${1:-}

  case "$command" in
    -h|--help|help|'')
      usage
      return
      ;;
  esac

  need jq
  need niri
  need flock

  case "$command" in
    contextual|local)
      (($# >= 4)) || { usage >&2; exit 2; }
      shift
      lock_runtime
      run_contextual "$@"
      ;;
    singleton|single)
      (($# >= 4)) || { usage >&2; exit 2; }
      shift
      lock_runtime
      run_singleton "$@"
      ;;
    inspect)
      (($# == 1)) || { usage >&2; exit 2; }
      inspect_state
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
